create_clock -name core_clk -period 1000.0 [get_ports clk_i]
set_false_path -from [get_ports rst_ni]
set_input_delay 5.0 -clock core_clk [get_ports {start_valid_i start_tag_i[*] start_vectors_per_bank_i[*] start_row_i[*] start_x_base_col_i[*] start_affine_base_col_i[*] start_output_base_col_i[*] reduction_ready_i[*] replay_request_valid_i replay_request_tag_i[*] replay_request_vectors_per_bank_i[*] replay_request_bank_mask_i[*] replay_ready_i[*] writeback_valid_i[*] writeback_tag_i[*] writeback_data_i[*] writeback_last_i[*] cmd_ready_i read_valid_i read_data_i[*]}]
set_output_delay 5.0 -clock core_clk [get_ports {start_ready_o reduction_valid_o[*] reduction_data_o[*] replay_request_ready_o replay_valid_o[*] replay_tag_o[*] replay_x_o[*] replay_gamma_o[*] replay_beta_o[*] replay_last_o[*] writeback_ready_o[*] cmd_valid_o cmd_o[*] cmd_bank_o[*] cmd_row_o[*] cmd_col_o[*] cmd_write_data_o[*] cmd_write_mask_o[*] read_ready_o done_o protocol_error_o cycle_count_o[*] act_command_count_o[*] read_command_count_o[*] write_command_count_o[*] pre_command_count_o[*] command_wait_cycles_o[*]}]
