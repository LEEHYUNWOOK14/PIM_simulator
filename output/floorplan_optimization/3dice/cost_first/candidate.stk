material SILICON :
  thermal conductivity 1.30e-04 ;
  volumetric heat capacity 1.631e-12 ;

material UNDERFILL :
  thermal conductivity 5.0e-06 ;
  volumetric heat capacity 1.760e-12 ;

top heat sink :
  heat transfer coefficient 5.0e-09 ;
  temperature 300.0 ;

dimensions :
  chip length 8000, width 12000 ;
  cell length 250, width 750 ;

layer BUMP :
  height 15 ;
  material UNDERFILL ;

die DRAM :
  source 1 SILICON ;
  layer 31 SILICON ;

die LOGIC_DIE :
  source 1 SILICON ;
  layer 99 SILICON ;

stack:
  die DRAM_7 DRAM floorplan "zero.flp" ;
  layer BUMP_7 BUMP ;
  die DRAM_6 DRAM floorplan "zero.flp" ;
  layer BUMP_6 BUMP ;
  die DRAM_5 DRAM floorplan "zero.flp" ;
  layer BUMP_5 BUMP ;
  die DRAM_4 DRAM floorplan "zero.flp" ;
  layer BUMP_4 BUMP ;
  die DRAM_3 DRAM floorplan "zero.flp" ;
  layer BUMP_3 BUMP ;
  die DRAM_2 DRAM floorplan "zero.flp" ;
  layer BUMP_2 BUMP ;
  die DRAM_1 DRAM floorplan "zero.flp" ;
  layer BUMP_1 BUMP ;
  die DRAM_0 DRAM floorplan "zero.flp" ;
  layer BUMP_0 BUMP ;
  die LOGIC LOGIC_DIE floorplan "logic.flp" ;

solver:
  steady ;
  initial temperature 300.0 ;

output:
  Tmap ( LOGIC, "temperature_map.txt", final );
  Tflp ( LOGIC, "floorplan_temperature.txt", maximum, final );
